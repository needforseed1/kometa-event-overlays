# Copy to .env and replace every value marked CHANGE_ME.
PLEX_URL=http://plex:32400
PLEX_TOKEN=CHANGE_ME
TMDB_API_KEY=CHANGE_ME

# Names must exactly match the library keys in config/config.yml.
TV_LIBRARIES=TV Shows
MOVIE_LIBRARIES=Movies

TZ=UTC
IMDB_SYNC_DRY_RUN=true

# Optional: set your own strong webhook token. Leave blank to generate one in
# the state volume on first start.
IMDB_SYNC_WEBHOOK_TOKEN=

# Optional tuning. The defaults shown match the tested deployment.
IMDB_SYNC_POLL_HOURS=6
IMDB_SYNC_EVENT_DEBOUNCE_SECONDS=90
IMDB_SYNC_EVENT_RETRY_SECONDS=120
IMDB_SYNC_EVENT_MAX_ATTEMPTS=10
IMDB_SYNC_HEALTH_MAX_AGE_HOURS=14
OVERLAY_WORKER_POLL_SECONDS=2
OVERLAY_WORKER_RETRY_SECONDS=300
